{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Article",
    "description": "Insights, Analysis, and Reflections posts, including the homepage Featured Writings"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "section": {
      "type": "enumeration",
      "enum": [
        "insights",
        "analysis",
        "reflections"
      ],
      "required": true
    },
    "tag": {
      "type": "string"
    },
    "excerpt": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "publishDate": {
      "type": "date"
    },
    "readTime": {
      "type": "string"
    },
    "featuredOnHome": {
      "type": "boolean",
      "default": false
    },
    "homeOrder": {
      "type": "integer",
      "default": 0
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}